<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400" width="100%">
<title>Zhihu Threads — 用 AI 把模糊问题变成知乎证据学习线</title>
<defs>
  <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#FAF7F2"/>
    <stop offset="1" stop-color="#F0EBE3"/>
  </linearGradient>
  <linearGradient id="bridge" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="#C9A96E"/>
    <stop offset="0.5" stop-color="#D4A84B"/>
    <stop offset="1" stop-color="#C9A96E"/>
  </linearGradient>
</defs>
<rect width="1200" height="400" rx="12" fill="url(#bg)"/>
<rect x="1.5" y="1.5" width="1197" height="397" rx="11" fill="none" stroke="#D4CFC5" stroke-width="1"/>

<!-- bridge line -->
<line x1="40" y1="80" x2="1160" y2="80" stroke="url(#bridge)" stroke-width="2.5" stroke-dasharray="8,4"/>
<!-- bridge cards -->
<g font-family="-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC',sans-serif" font-size="13" font-weight="600" fill="#5A5347">
  <rect x="80" y="52" width="120" height="28" rx="6" fill="#FFFFFF" stroke="#D4CFC5"/>
  <text x="140" y="71" text-anchor="middle">知乎回答 · 2016</text>
  <rect x="300" y="52" width="120" height="28" rx="6" fill="#FFF8E1" stroke="#C9A96E"/>
  <text x="360" y="71" text-anchor="middle">专栏文章 · 2023</text>
  <rect x="520" y="52" width="120" height="28" rx="6" fill="#FFFFFF" stroke="#D4CFC5"/>
  <text x="580" y="71" text-anchor="middle">知乎回答 · 2026</text>
</g>

<!-- character illustration -->
<image href="data:image/png;base64," x="720" y="65" width="420" height="310" preserveAspectRatio="xMidYMid meet"/>

<!-- title block -->
<g font-family="-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC',sans-serif">
  <text x="60" y="140" font-size="14" fill="#9B9484" font-weight="500" letter-spacing="1">基于知乎真实内容的学习工具</text>
  <text x="60" y="195" font-size="52" font-weight="800" fill="#2A251C">Zhihu Threads</text>
  <text x="60" y="245" font-size="18" fill="#5A5347" font-weight="400">用 AI 把一个模糊问题</text>
  <text x="60" y="272" font-size="18" fill="#5A5347" font-weight="400">变成可追问、可收藏的</text>
  <text x="60" y="299" font-size="18" fill="#C9A96E" font-weight="700">知乎证据学习线</text>
</g>

<!-- bottom badges -->
<g font-family="-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC',sans-serif" font-size="12" font-weight="500">
  <rect x="60" y="330" width="150" height="30" rx="8" fill="none" stroke="#C9A96E" stroke-width="1.5"/>
  <text x="135" y="350" text-anchor="middle" fill="#9B7E3C">TanStack Start</text>
  <rect x="225" y="330" width="110" height="30" rx="8" fill="none" stroke="#D4CFC5"/>
  <text x="280" y="350" text-anchor="middle" fill="#9B9484">Effect TS</text>
  <rect x="350" y="330" width="100" height="30" rx="8" fill="none" stroke="#D4CFC5"/>
  <text x="400" y="350" text-anchor="middle" fill="#9B9484">SQLite</text>
  <rect x="465" y="330" width="90" height="30" rx="8" fill="none" stroke="#D4CFC5"/>
  <text x="510" y="350" text-anchor="middle" fill="#9B9484">345 tests</text>
</g>
</svg>